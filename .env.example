# Copy this file to .env.local and fill in real values there.
# Never commit .env.local or any file containing real keys.

# Public URL of the site, used for canonical links and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Let search engines index the site. Keep "false" on preview/temporary hosts
# (e.g. *.vercel.app); set "true" only once the real domain is live.
NEXT_PUBLIC_SITE_INDEXABLE=false

# --- Phase 3+: Supabase (not needed yet) ---
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Never expose to the browser or prefix with NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Phase 4+: admin access (not needed yet) ---
# Comma-separated list of admin email addresses.
# ADMIN_EMAILS=owner@example.com

# --- VoiceHub (ElevenLabs text to speech) ---
# Server only. Never prefix with NEXT_PUBLIC_ and never commit a real value.
# ELEVENLABS_API_KEY=your-elevenlabs-api-key
# Public voice generation is OFF unless this is exactly "enabled". The endpoint
# has no sign-in, rate limit or durable usage cap yet, so enabling it lets
# anyone who can reach the site spend the ElevenLabs credits. Leave unset on
# any public deployment; enable only on a private environment for testing.
# VOICEHUB_PUBLIC_GENERATION=
