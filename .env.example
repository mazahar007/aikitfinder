# Copy this file to .env.local and fill in real values there.
# Never commit .env.local or any file containing real keys.

# Public URL of the site, used for canonical links and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Let search engines index the site. Keep "false" on preview/temporary hosts
# (e.g. *.vercel.app); set "true" only once the real domain is live.
NEXT_PUBLIC_SITE_INDEXABLE=false

# --- Supabase: accounts and database ---
# With both set, sign-up and log-in are on. Without them the site still builds
# and runs, with accounts switched off. Both values are public (safe in the
# browser): access is limited by row level security in the database.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# The app does not use a secret or service-role key. Do not add one here unless
# a server-only feature needs it, and never prefix it with NEXT_PUBLIC_.

# --- Guest search limit ("3 Free Searches") ---
# Both are server-only secrets: never prefix them with NEXT_PUBLIC_ and never
# commit real values. With both set (and migration 0008 applied) visitors
# without an account get 3 Directory searches per UTC day. With either one
# missing the limit is off and search works as before.
#
# Signs the guest cookie. At least 32 characters. Generate one with:
#   openssl rand -base64 48
# GUEST_SEARCH_SECRET=
# The project's secret key (Supabase → Project Settings → API Keys, starts
# "sb_secret_"). Used on the server only, to call the two guest-search
# database functions.
# SUPABASE_SECRET_KEY=

# --- Admin panel: provider credentials ---
# Server only. Encrypts provider credentials before they are stored
# (AES-256-GCM). 32 random bytes, base64. Without it the admin panel cannot
# save credentials; everything else works. Losing or changing this key makes
# saved credentials unreadable, so keep a copy in a password manager.
# Generate one with:
#   openssl rand -base64 32
# INTEGRATIONS_ENCRYPTION_KEY=

# --- VoiceHub (ElevenLabs text to speech) ---
# Server only. Never prefix with NEXT_PUBLIC_ and never commit a real value.
# ELEVENLABS_API_KEY=your-elevenlabs-api-key
# Public voice generation is OFF unless this is exactly "enabled". The endpoint
# has no sign-in, rate limit or durable usage cap yet, so enabling it lets
# anyone who can reach the site spend the ElevenLabs credits. Leave unset on
# any public deployment; enable only on a private environment for testing.
# VOICEHUB_PUBLIC_GENERATION=
